# OpenAI-compatible chat provider. LM Studio is the local default.
LLM_PROVIDER=lmstudio
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=lm-studio
MODEL_NAME=qwen2.5-3b-instruct
MODEL_VERSION=local

# Optional specialized models.
SUPERVISOR_MODEL_NAME=
CODE_MODEL_NAME=
EMBEDDING_MODEL_NAME=text-embedding-nomic-embed-text-v1.5
EMBEDDING_MODEL_VERSION=local
EMBEDDING_DIMENSION=384
EMBEDDING_REMOTE_ENABLED=false

# Tenant/brand scope and persistence.
DEFAULT_TENANT_ID=default
DEFAULT_BRAND_ID=default
MEMORY_DB_PATH=.agent_memory/session.db
POSTGRES_DSN=

# Runtime settings.
WORKSPACE_ROOT=.
MAX_SEARCH_RESULTS=5
LM_TIMEOUT_SEC=20
LM_MAX_RETRIES=1
